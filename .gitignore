# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
fss
FSS

# Scrape output files
*.db
*.csv
*.json

# ...but always keep test fixtures (scraper testdata/ dirs may hold .json/.csv)
!**/testdata/
!**/testdata/**

# ...and the embedded translation catalogs
!internal/i18n/locales/*.json

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Build output (release archives, nfpm packages)
dist/

# Editor/IDE
.idea/
.vscode/

# Local config — holds API keys and site credentials, never commit
/config.yaml
/config.yml
